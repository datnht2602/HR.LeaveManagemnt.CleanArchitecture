@page "/leaverequests/details/{id:int}"
<h3>Details</h3>

<div class="alert alert-@_className" role="alert">
    <h4 class="alert-heading">@_headingText</h4>
    <p>
        <strong>Employee name:</strong> @_leaveRequestVm.Employee.Firstname @_leaveRequestVm.Employee.Lastname <br/>
    </p>
    <hr />
    <p>
        Date Requested - @_leaveRequestVm.DateRequested
    </p>
</div>

<div>
    <hr/>
    <dl class="row">
        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@_leaveRequestVm.StartDate</dd>
        <dt class="col-sm-2">End Date</dt>
        <dd class="col-sm-10">@_leaveRequestVm.EndDate</dd>
        <dt class="col-sm-2">Leave Type</dt>
        <dd class="col-sm-10">@_leaveRequestVm.LeaveType.Name</dd>
        <dt class="col-sm-2">Request Comment</dt>
        <dd class="col-sm-10">@_leaveRequestVm.RequestComments</dd>
    </dl>
</div>

<div>

    @if (_leaveRequestVm.Approved == null)
    {
        <button class="btn btn-success" @onclick="(() => ChangeApproval(true))">
            Approve
        </button>
        <button class="btn btn-danger" @onclick="(() => ChangeApproval(false))">
            Reject
        </button>
    }
    <BackToList Target="leaverequests/" />
   
</div>
